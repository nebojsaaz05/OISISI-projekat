<Window x:Class="GUI.View.UpdateAutor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI.View"
        mc:Ignorable="d"
        Title="Izmena autora" Height="450" Width="400">
    <!-- Po uzoru na AddVehicle iz CRUDExample (vjezbe 6) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0">Ime</Label>
        <Label Grid.Row="1" Grid.Column="0">Prezime</Label>
        <Label Grid.Row="2" Grid.Column="0">Datum rođenja</Label>
        <Label Grid.Row="3" Grid.Column="0">Telefon</Label>
        <Label Grid.Row="4" Grid.Column="0">E-mail</Label>
        <Label Grid.Row="5" Grid.Column="0">Broj lične karte</Label>
        <Label Grid.Row="6" Grid.Column="0">Godine iskustva</Label>
        <Label Grid.Row="7" Grid.Column="0">Ulica</Label>
        <Label Grid.Row="8" Grid.Column="0">Broj</Label>
        <Label Grid.Row="9" Grid.Column="0">Grad</Label>
        <Label Grid.Row="10" Grid.Column="0">Država</Label>

        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Path=Autor.Ime, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Path=Autor.Prezime, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Path=Autor.DatumRodjenja, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Path=Autor.Telefon, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Path=Autor.Email, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Path=Autor.BrojLicneKarte, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Path=Autor.GodineIskustva, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Path=Autor.Ulica, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Path=Autor.Broj, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Path=Autor.Grad, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Path=Autor.Drzava, UpdateSourceTrigger=PropertyChanged}"></TextBox>

        <Button Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Click="Update_Click">Potvrdi</Button>
    </Grid>
</Window>