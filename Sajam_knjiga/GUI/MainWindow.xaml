<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI"
        mc:Ignorable="d"
        Title="Sajam knjiga"
        WindowStartupLocation="CenterScreen">
    
    <DockPanel>
        <!-- #menu_bar extra nena -->
        <Menu DockPanel.Dock="Top">
        </Menu>

        <!-- #toolbar (Student 2) - po uzoru na ObservableCollectionExample (vjezbe 6) -->
        <ToolBar DockPanel.Dock="Top">
            <Button Click="Dodaj_Click" ToolTip="Dodaj">Dodaj</Button>
            <Button Click="Izmeni_Click" ToolTip="Izmijeni">Izmijeni</Button>
            <Button Click="Obrisi_Click" ToolTip="Obriši">Obriši</Button>
            <Separator/>
            <TextBox x:Name="PretragaTextBox" Width="200" ToolTip="Unesite kriterijum pretrage"/>
            <Button Click="Pretraga_Click" ToolTip="Pretraži">Pretraži</Button>
        </ToolBar>

        <!-- #status_bar extra nena -->
        <StatusBar DockPanel.Dock="Bottom">
        </StatusBar>

        <!-- centralni dio sa tabovima -->
        <TabControl x:Name="Tabovi">
            <TabItem Header="Posetioci">
                <!-- #prikaz_posetilaca extra nena -->
            </TabItem>
            <TabItem Header="Autori">
                <DataGrid ItemsSource="{Binding Autori}"
                          SelectedItem="{Binding SelectedAutor}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ime" Binding="{Binding Ime}" Width="*"/>
                        <DataGridTextColumn Header="Prezime" Binding="{Binding Prezime}" Width="*"/>
                        <DataGridTextColumn Header="Broj lične karte" Binding="{Binding BrojLicneKarte}" Width="*"/>
                        <DataGridTextColumn Header="Datum rođenja" Binding="{Binding DatumRodjenja, StringFormat=dd.MM.yyyy.}" Width="*"/>
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Knjige">
                <DataGrid ItemsSource="{Binding Knjige}"
                          SelectedItem="{Binding SelectedKnjiga}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="*"/>
                        <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv}" Width="2*"/>
                        <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat=N2}" Width="*"/>
                        <DataGridTextColumn Header="Godina izdanja" Binding="{Binding GodinaIzdanja}" Width="*"/>
                        <DataGridTextColumn Header="Žanr" Binding="{Binding Zanr}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
